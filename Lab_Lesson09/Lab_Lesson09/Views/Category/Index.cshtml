@model IEnumerable<Lab_Lesson09.Models.Category>

@{
    ViewData["Title"] = "Danh sách danh mục";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">
                <i class="bi bi-tags me-2"></i>Danh mục sản phẩm (Categories)
            </h1>
            <p class="text-muted mb-0">Danh sách các danh mục dùng làm nguồn dữ liệu ComboBox cho Product</p>
        </div>
        <div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-box-seam me-1"></i> Xem sản phẩm
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 100px;">Mã danh mục (Id)</th>
                            <th>Tên danh mục (Name)</th>
                            <th class="text-center" style="width: 200px;">Số sản phẩm</th>
                            <th class="text-center" style="width: 150px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var count = Lab_Lesson09.Models.DataStore.GetProducts().Count(p => p.CategoryId == item.Id);
                            <tr>
                                <td class="text-center fw-bold">#@item.Id</td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Name</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">@count sản phẩm</span>
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-filter me-1"></i> Xem sản phẩm
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
