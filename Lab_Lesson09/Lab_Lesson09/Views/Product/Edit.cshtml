@model Lab_Lesson09.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa (#@Model.Id)</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin sản phẩm
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate id="productEditForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Image" />

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Vui lòng kiểm tra lại các thông tin sau:</strong>
                        </div>

                        <div class="row g-3">
                            <!-- Tên sản phẩm -->
                            <div class="col-md-12">
                                <label asp-for="Name" class="form-label fw-bold">
                                    Tên sản phẩm <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Nhập tên sản phẩm (6 - 150 ký tự)..." />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                                <div class="form-text">Tên sản phẩm bắt buộc nhập, độ dài từ 6 đến 150 ký tự.</div>
                            </div>

                            <!-- Danh mục sản phẩm (ComboBox) -->
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold">
                                    Danh mục sản phẩm <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select form-select-lg">
                                    <option value="">-- Vui lòng chọn danh mục --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                <div class="form-text">Chọn danh mục từ danh sách các đối tượng Category.</div>
                            </div>

                            <!-- Upload ảnh mới (tùy chọn khi edit) -->
                            <div class="col-md-6">
                                <label asp-for="ImageFile" class="form-label fw-bold">
                                    Thay đổi hình ảnh mới
                                </label>
                                <input asp-for="ImageFile" type="file" class="form-control form-control-lg" id="imageInput" accept=".jpg,.jpeg,.png,.gif,.webp" />
                                <span asp-validation-for="ImageFile" class="text-danger small"></span>
                                <div class="form-text">Để trống nếu muốn giữ nguyên ảnh hiện tại.</div>
                            </div>

                            <!-- Hiển thị ảnh hiện tại và xem trước ảnh mới -->
                            <div class="col-12">
                                <div class="row g-3 align-items-center">
                                    @if (!string.IsNullOrEmpty(Model.Image))
                                    {
                                        <div class="col-auto">
                                            <label class="form-label fw-semibold text-muted d-block">Ảnh hiện tại:</label>
                                            <div class="p-2 border rounded bg-light d-inline-block text-center">
                                                <img src="~/products/@Model.Image" alt="@Model.Name" class="rounded img-fluid" style="max-height: 140px; max-width: 200px; object-fit: cover;" onerror="this.src='https://placehold.co/120x90?text=No+Image'" />
                                                <small class="d-block text-muted mt-1 text-truncate" style="max-width: 180px;">@Model.Image</small>
                                            </div>
                                        </div>
                                    }

                                    <div class="col-auto" id="previewContainer" style="display: none;">
                                        <label class="form-label fw-semibold text-primary d-block">Ảnh mới được chọn:</label>
                                        <div class="p-2 border border-primary rounded bg-light d-inline-block text-center">
                                            <img id="imagePreview" src="#" alt="New Preview" class="rounded img-fluid" style="max-height: 140px; max-width: 200px; object-fit: contain;" />
                                            <small class="d-block text-primary mt-1">Sẽ thay thế ảnh cũ khi lưu</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Giá chuẩn -->
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold">
                                    Giá chuẩn (VNĐ) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="Price" type="number" step="1000" min="100000" class="form-control" id="priceInput" />
                                    <span class="input-group-text bg-light">VNĐ</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                                <div class="form-text">Giá chuẩn tối thiểu phải từ <strong>100.000 VNĐ</strong>.</div>
                            </div>

                            <!-- Giá khuyến mãi -->
                            <div class="col-md-6">
                                <label asp-for="SalePrice" class="form-label fw-bold">
                                    Giá khuyến mãi (VNĐ) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="SalePrice" type="number" step="1000" min="0" class="form-control" id="salePriceInput" />
                                    <span class="input-group-text bg-light">VNĐ</span>
                                </div>
                                <span asp-validation-for="SalePrice" class="text-danger small"></span>
                                <div class="form-text" id="salePriceHint">
                                    Không âm và phải nhỏ hơn giá chuẩn ít nhất 10% (tối đa 90% giá chuẩn).
                                </div>
                            </div>

                            <!-- Mô tả sản phẩm -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold">
                                    Mô tả chi tiết <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                                <div class="form-text">
                                    Không vượt quá 1500 ký tự. Không được chứa các từ nhạy cảm (như: <em>die, admin, fack...</em>).
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Nút bấm -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg px-5 fw-bold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Cập nhật thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Preview hình ảnh khi người dùng chọn file mới
        document.getElementById('imageInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            const previewContainer = document.getElementById('previewContainer');
            const imagePreview = document.getElementById('imagePreview');

            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    imagePreview.src = event.target.result;
                    previewContainer.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                imagePreview.src = '#';
                previewContainer.style.display = 'none';
            }
        });

        // Hỗ trợ hiển thị gợi ý giá khuyến mãi tối đa
        const priceInput = document.getElementById('priceInput');
        const salePriceHint = document.getElementById('salePriceHint');

        function updateSalePriceHint() {
            const price = parseFloat(priceInput.value);
            if (!isNaN(price) && price >= 100000) {
                const maxSale = Math.floor(price * 0.9);
                salePriceHint.innerHTML = `<span class="text-primary fw-semibold"><i class="bi bi-info-circle me-1"></i>Với giá chuẩn ${price.toLocaleString('vi-VN')} đ, giá khuyến mãi hợp lệ tối đa là <strong>${maxSale.toLocaleString('vi-VN')} đ</strong> (giảm ít nhất 10%).</span>`;
            } else {
                salePriceHint.innerHTML = 'Không âm và phải nhỏ hơn giá chuẩn ít nhất 10% (tối đa 90% giá chuẩn).';
            }
        }

        priceInput.addEventListener('input', updateSalePriceHint);
        updateSalePriceHint();
    </script>
}
