@model Lab_Lesson09.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm: " + Model.Name;
    float discountPercent = 0;
    float savings = 0;
    if (Model.Price > 0 && Model.SalePrice > 0 && Model.SalePrice < Model.Price)
    {
        discountPercent = (float)Math.Round((1.0 - (double)Model.SalePrice / Model.Price) * 100);
        savings = Model.Price - Model.SalePrice;
    }
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết (#@Model.Id)</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0 overflow-hidden">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>Thông tin chi tiết sản phẩm #@Model.Id
                    </h5>
                    <span class="badge bg-info text-dark px-3 py-2 fs-6">
                        <i class="bi bi-tag-fill me-1"></i>@(Model.Category?.Name ?? "Chưa phân loại")
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 align-items-center">
                        <!-- Cột Hình ảnh -->
                        <div class="col-md-5 text-center">
                            <div class="p-3 border rounded bg-light shadow-sm position-relative">
                                @if (discountPercent > 0)
                                {
                                    <div class="position-absolute top-0 start-0 m-3 badge bg-danger fs-6 shadow-sm">
                                        Giảm @discountPercent%
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.Image))
                                {
                                    <img src="~/products/@Model.Image" alt="@Model.Name" 
                                         class="img-fluid rounded" 
                                         style="max-height: 320px; object-fit: contain;" 
                                         onerror="this.src='https://placehold.co/400x300?text=No+Image'" />
                                }
                                else
                                {
                                    <div class="py-5 text-muted">
                                        <i class="bi bi-image fs-1 d-block mb-2"></i>
                                        Chưa có hình ảnh
                                    </div>
                                }
                            </div>
                            <small class="text-muted d-block mt-2">File: <code>@Model.Image</code></small>
                        </div>

                        <!-- Cột Thông tin chi tiết -->
                        <div class="col-md-7">
                            <h3 class="fw-bold text-dark mb-3">@Model.Name</h3>

                            <div class="p-3 bg-light rounded mb-3 border">
                                <div class="row align-items-center">
                                    <div class="col-sm-6 mb-2 mb-sm-0">
                                        <div class="text-muted small">Giá khuyến mãi ưu đãi:</div>
                                        <div class="text-danger fw-bold fs-3">
                                            @Model.SalePrice.ToString("N0") <span class="fs-6">VNĐ</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="text-muted small">Giá chuẩn ban đầu:</div>
                                        <div class="text-secondary text-decoration-line-through fs-5">
                                            @Model.Price.ToString("N0") VNĐ
                                        </div>
                                        @if (savings > 0)
                                        {
                                            <div class="text-success small fw-semibold mt-1">
                                                <i class="bi bi-check2-all"></i> Tiết kiệm: @savings.ToString("N0") VNĐ
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <dl class="row mb-0">
                                <dt class="col-sm-4 text-muted">Mã sản phẩm (ID):</dt>
                                <dd class="col-sm-8 fw-semibold">#@Model.Id</dd>

                                <dt class="col-sm-4 text-muted">Danh mục (Category):</dt>
                                <dd class="col-sm-8 fw-semibold text-primary">
                                    @(Model.Category?.Name ?? "Chưa phân loại") (Mã: @Model.CategoryId)
                                </dd>

                                <dt class="col-sm-4 text-muted">Mô tả sản phẩm:</dt>
                                <dd class="col-sm-8 text-secondary" style="white-space: pre-line;">
                                    @Model.Description
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white p-3 border-top d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-1"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
