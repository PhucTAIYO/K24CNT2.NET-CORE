@model IEnumerable<Lab_Lesson09.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<Lab_Lesson09.Models.Category> ?? new List<Lab_Lesson09.Models.Category>();
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">
                <i class="bi bi-box-seam me-2"></i>Quản lý Sản phẩm
            </h1>
            <p class="text-muted mb-0">Hệ thống quản lý sản phẩm với Data Validation & Upload ảnh</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Thêm mới sản phẩm
            </a>
        </div>
    </div>

    <!-- Thông báo kết quả thao tác -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Thành công!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Lỗi!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo tên sản phẩm hoặc mô tả..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoryId" class="form-select">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var cat in categories)
                        {
                            if (ViewBag.CurrentCategoryId != null && (int)ViewBag.CurrentCategoryId == cat.Id)
                            {
                                <option value="@cat.Id" selected>@cat.Name</option>
                            }
                            else
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || ViewBag.CurrentCategoryId != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách sản phẩm -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-secondary">
                    Tổng số: <span class="badge bg-primary fs-6">@Model.Count()</span> sản phẩm
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <h5 class="mt-3 text-secondary">Không tìm thấy sản phẩm nào!</h5>
                    <p class="text-muted">Vui lòng thử tìm kiếm với từ khóa khác hoặc bấm nút thêm mới.</p>
                    <a asp-action="Create" class="btn btn-primary mt-2">Thêm sản phẩm mới</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 80px;">STT</th>
                                <th style="width: 120px;">Hình ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th class="text-end">Giá chuẩn</th>
                                <th class="text-end">Giá khuyến mãi</th>
                                <th class="text-center" style="width: 220px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int stt = 1; }
                            @foreach (var item in Model)
                            {
                                float discountPercent = 0;
                                if (item.Price > 0 && item.SalePrice > 0 && item.SalePrice < item.Price)
                                {
                                    discountPercent = (float)Math.Round((1.0 - (double)item.SalePrice / item.Price) * 100);
                                }

                                <tr>
                                    <td class="text-center fw-semibold text-muted">@(stt++)</td>
                                    <td>
                                        <div class="position-relative" style="width: 90px; height: 68px;">
                                            @if (!string.IsNullOrEmpty(item.Image))
                                            {
                                                <img src="~/products/@item.Image" alt="@item.Name" 
                                                     class="img-fluid rounded border shadow-sm w-100 h-100" 
                                                     style="object-fit: cover;"
                                                     onerror="this.src='https://placehold.co/100x75?text=No+Image'" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center border">
                                                    <i class="bi bi-image text-muted fs-4"></i>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none fw-bold text-dark d-block">
                                            @item.Name
                                        </a>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 320px;" title="@item.Description">
                                            @item.Description
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark px-2 py-1 rounded-pill">
                                            <i class="bi bi-tag-fill me-1"></i>@(item.Category?.Name ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-muted text-decoration-line-through fw-semibold">
                                            @item.Price.ToString("N0") đ
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold text-danger fs-6">
                                            @item.SalePrice.ToString("N0") đ
                                        </div>
                                        @if (discountPercent > 0)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">
                                                -@discountPercent%
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
