@model IEnumerable<HVPleeson07.Models.DataModels.HVPMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
    </p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.HVPMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HVPUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HVPPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HVPFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.HVPEmail)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.HVPMemberId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HVPUserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HVPPassword)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HVPFullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HVPEmail)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
