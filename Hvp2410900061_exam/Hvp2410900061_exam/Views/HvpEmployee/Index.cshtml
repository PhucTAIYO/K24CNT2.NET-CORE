@model IEnumerable<Hvp2410900061_exam.Models.HvpEmployee>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-people-fill me-2"></i>Danh sách nhân viên</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.HvpName)</th>
                        <th>@Html.DisplayNameFor(model => model.HvpGender)</th>
                        <th>@Html.DisplayNameFor(model => model.HvpBirthDay)</th>
                        <th>@Html.DisplayNameFor(model => model.HvpEmail)</th>
                        <th>@Html.DisplayNameFor(model => model.HvpPhone)</th>
                        <th>@Html.DisplayNameFor(model => model.HvpActive)</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
@foreach (var item in Model) {
                    <tr>
                        <td class="fw-semibold">
                            @Html.DisplayFor(modelItem => item.HvpName)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.HvpGender)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.HvpBirthDay)
                        </td>
                        <td>
                            <i class="bi bi-envelope-fill text-muted me-1"></i>@Html.DisplayFor(modelItem => item.HvpEmail)
                        </td>
                        <td>
                            <i class="bi bi-telephone-fill text-muted me-1"></i>@Html.DisplayFor(modelItem => item.HvpPhone)
                        </td>
                        <td>
                            <span class="badge rounded-pill bg-info text-dark">
                                @Html.DisplayFor(modelItem => item.HvpActive)
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
}
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3 text-center">
        <i class="bi bi-info-circle me-2"></i>Chưa có dữ liệu nhân viên nào.
    </div>
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">