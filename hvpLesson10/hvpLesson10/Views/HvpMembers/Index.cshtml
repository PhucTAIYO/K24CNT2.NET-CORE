@model IEnumerable<hvpLesson10.Models.HvpMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HvpUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HvpPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HvpFullname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HvpEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HvpPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HvpStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.HvpUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.HvpPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.HvpFullname)
            </td>
            <td>
                @Html.DisplayFor(model => item.HvpEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.HvpPhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.HvpStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
