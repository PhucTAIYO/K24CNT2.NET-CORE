@model IEnumerable<HvpLesson12.Models.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-dark">Quản lý Banner quảng cáo</h2>
        <a class="btn btn-sm btn-success px-3" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Thêm mới banner
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.Image)</th>
                            <th>@Html.DisplayNameFor(model => model.Description)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
                            <th class="text-center" style="width: 220px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold">@Html.DisplayFor(modelItem => item.Name)</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.Image)) {
                                    <img src="~/Banner/@item.Image" alt="@item.Name" class="rounded shadow-sm" style="width: 100px; height: 45px; object-fit: cover;" onerror="this.src='/images/no-image.png';" />
                                } else {
                                    <span class="text-muted small">Không có ảnh</span>
                                }
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                            <td>
                                @if (item.Status == 1) {
                                    <span class="badge bg-success">Hiển thị (1)</span>
                                } else {
                                    <span class="badge bg-secondary">Tạm ẩn (0)</span>
                                }
                            </td>
                            <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <a class="btn btn-sm btn-success" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
