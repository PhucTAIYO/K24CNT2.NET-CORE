@model IEnumerable<HvpLesson12.Models.Product>

@{
    ViewData["Title"] = "Trang chủ - Cửa hàng thời trang";
    var banners = ViewBag.Banners as List<HvpLesson12.Models.Banner>;
}

<!-- Bài 4: Hiển thị Banner trên trang chủ -->
@if (banners != null && banners.Count > 0)
{
    <div id="homeBannerCarousel" class="carousel slide mb-5 shadow rounded overflow-hidden" data-bs-ride="carousel" style="min-height: 380px;">
        <div class="carousel-indicators">
            @for (int i = 0; i < banners.Count; i++)
            {
                <button type="button" data-bs-target="#homeBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i+1)"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (int i = 0; i < banners.Count; i++)
            {
                var banner = banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")" style="height: 380px; background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                    @if (!string.IsNullOrEmpty(banner.Image))
                    {
                        <img src="~/Banner/@banner.Image" class="d-block w-100 h-100" alt="@banner.Name" style="object-fit: cover; opacity: 0.85;" onerror="this.style.display='none';" />
                    }
                    <div class="carousel-caption d-none d-md-block text-start p-4" style="background: rgba(0,0,0,0.5); border-radius: 12px; bottom: 30px; left: 10%; right: 10%;">
                        <h2 class="fw-bold text-white mb-2">@banner.Name</h2>
                        <p class="fs-5 text-light mb-3">@banner.Description</p>
                        <a asp-action="Product" class="btn btn-primary px-4 py-2 fw-semibold">Khám phá ngay</a>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}

<!-- Bài 2: Hiển thị sản phẩm dạng cột có dạng như lab guide Page 22 -->
<div class="container py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark border-start border-4 border-primary ps-3">Danh sách sản phẩm nổi bật</h3>
        <a asp-action="Product" class="btn btn-outline-primary btn-sm px-3">Xem tất cả sản phẩm &raquo;</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 product-card hover-lift">
                    <div class="position-relative overflow-hidden" style="height: 220px; background-color: #f8fafc;">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="~/Product/@item.Image" class="card-img-top w-100 h-100" alt="@item.Name" style="object-fit: cover;" onerror="this.src='/images/no-image.png';" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                <i class="bi bi-image fs-1"></i>
                            </div>
                        }
                        @if (item.SalePrice > 0 && item.SalePrice < item.Price)
                        {
                            <span class="position-absolute top-0 start-0 m-2 badge bg-danger">
                                Giảm @((int)((item.Price - item.SalePrice) / item.Price * 100))%
                            </span>
                        }
                    </div>
                    <div class="card-body d-flex flex-column text-center p-3">
                        <span class="badge bg-light text-secondary mb-1 align-self-center">@(item.Category?.Name ?? "Sản phẩm")</span>
                        <h6 class="card-title fw-bold text-truncate mb-2" title="@item.Name">@item.Name</h6>
                        <div class="mt-auto">
                            @if (item.SalePrice > 0 && item.SalePrice < item.Price)
                            {
                                <div class="text-danger fw-bold fs-6">@item.SalePrice.ToString("N0") VNĐ</div>
                                <div class="text-muted text-decoration-line-through small">@item.Price.ToString("N0") VNĐ</div>
                            }
                            else
                            {
                                <div class="text-primary fw-bold fs-6">@item.Price.ToString("N0") VNĐ</div>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 text-center pb-3">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary w-100">Chi tiết sản phẩm</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
