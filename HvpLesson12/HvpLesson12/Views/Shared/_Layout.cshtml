<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HvpLesson12 - ASP.NET Core EF</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html {
            scrollbar-gutter: stable;
            overflow-y: scroll;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .navbar {
            backdrop-filter: blur(10px);
            background-color: rgba(255, 255, 255, 0.95) !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            min-height: 64px;
        }
        .navbar-brand {
            font-weight: 800;
            color: #2563eb !important;
            letter-spacing: -0.5px;
            white-space: nowrap;
        }
        .nav-link {
            font-weight: 600;
            color: #475569 !important;
            transition: color 0.2s ease;
            white-space: nowrap;
            font-size: 0.93rem;
            padding-left: 0.65rem !important;
            padding-right: 0.65rem !important;
        }
        .nav-link:hover, .nav-link.active {
            color: #2563eb !important;
        }
        .product-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-radius: 12px;
            overflow: hidden;
        }
        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
        }
        .card {
            border-radius: 12px;
        }
        .table thead th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.82rem;
            letter-spacing: 0.5px;
        }
        .badge {
            font-weight: 600;
            padding: 0.45em 0.75em;
            border-radius: 6px;
        }
        .footer {
            background-color: #ffffff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom sticky-top">
            <div class="container-fluid px-3 px-xl-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-code-slash text-primary fs-4"></i>
                    <span>HvpLesson12</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Product">
                                <i class="bi bi-grid me-1"></i> Shop (Bài 2)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam me-1"></i> Quản lý Sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-tags me-1"></i> Quản lý Danh mục
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Banners" asp-action="Index">
                                <i class="bi bi-images me-1"></i> Quản lý Banner
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="studentDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-mortarboard me-1"></i> Quản lý Sinh viên (Bài 5-6)
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="studentDropdown">
                                <li><a class="dropdown-item" asp-controller="StdClasses" asp-action="Index"><i class="bi bi-diagram-3 me-2"></i>Lớp học (StdClass)</a></li>
                                <li><a class="dropdown-item" asp-controller="Students" asp-action="Index"><i class="bi bi-people me-2"></i>Sinh viên (Student)</a></li>
                                <li><a class="dropdown-item" asp-controller="Subjects" asp-action="Index"><i class="bi bi-book me-2"></i>Môn học (Subjects)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Marks" asp-action="Index"><i class="bi bi-award me-2"></i>Bảng điểm (Marks)</a></li>
                            </ul>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 text-nowrap d-none d-md-inline-block" title="SQL Server: NetCoreCRUD & StudentManager">
                            <i class="bi bi-database-check me-1"></i> <span class="d-none d-xl-inline">SQL Server: </span>NetCoreCRUD &amp; StudentManager
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="footer border-top py-4 mt-auto">
        <div class="container text-center text-muted small">
            <div>&copy; 2026 - <strong>HvpLesson12</strong> - Devmaster LabGuide06 - Entity Framework Core Code-First</div>
            <div class="mt-1 text-secondary">MSSQL Server: <code>localhost</code> | Windows Authentication | Trusted_Connection=True</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
