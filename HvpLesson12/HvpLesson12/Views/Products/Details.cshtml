@model HvpLesson12.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container py-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Chi tiết sản phẩm: @Model.Name</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.Image)) {
                        <img src="~/Product/@Model.Image" alt="@Model.Name" class="img-fluid rounded shadow" style="max-height: 280px; object-fit: contain;" />
                    } else {
                        <div class="p-5 bg-light rounded text-muted">Chưa có ảnh</div>
                    }
                </div>
                <div class="col-md-8">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="col-sm-9 fw-bold fs-5">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Category)</dt>
                        <dd class="col-sm-9"><span class="badge bg-info text-dark">@(Model.Category?.Name ?? "Chưa phân loại")</span></dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Price)</dt>
                        <dd class="col-sm-9 text-primary fw-bold">@Model.Price.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SalePrice)</dt>
                        <dd class="col-sm-9 text-danger fw-bold">@Model.SalePrice.ToString("N0") VNĐ</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
                        <dd class="col-sm-9">
                            @if (Model.Status == 1) {
                                <span class="badge bg-success">Đang bán (1)</span>
                            } else {
                                <span class="badge bg-secondary">Tạm ẩn (0)</span>
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
                        <dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descriptions)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Descriptions)</dd>
                    </dl>

                    <div class="d-flex gap-2 mt-4">
                        <a class="btn btn-sm btn-primary px-3" asp-action="Edit" asp-route-id="@Model?.Id">Chỉnh sửa</a>
                        <a class="btn btn-sm btn-secondary px-3" asp-action="Index">Quay lại danh sách</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
