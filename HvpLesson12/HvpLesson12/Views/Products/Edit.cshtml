@model HvpLesson12.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container py-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Chỉnh sửa sản phẩm</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Image" />
                <input type="hidden" asp-for="CreatedDate" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh hiện tại</label>
                            <div class="mb-2">
                                @if (!string.IsNullOrEmpty(Model.Image)) {
                                    <img src="~/Product/@Model.Image" alt="@Model.Name" class="rounded shadow-sm" style="max-height: 120px; object-fit: contain;" />
                                } else {
                                    <span class="text-muted">Chưa có ảnh</span>
                                }
                            </div>
                            <label class="form-label fw-bold">Thay đổi hình ảnh (nếu muốn)</label>
                            <input type="file" name="file" class="form-control" accept="image/*" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Descriptions" class="form-label fw-bold"></label>
                            <textarea asp-for="Descriptions" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Descriptions" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold"></label>
                            <input asp-for="Price" class="form-control" type="number" step="any" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SalePrice" class="form-label fw-bold"></label>
                            <input asp-for="SalePrice" class="form-control" type="number" step="any" />
                            <span asp-validation-for="SalePrice" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="1">Hiển thị (1)</option>
                                <option value="0">Tạm ẩn (0)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <input type="submit" value="Cập nhật" class="btn btn-sm btn-success px-4" />
                    <a class="btn btn-sm btn-secondary px-3" asp-action="Index">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
