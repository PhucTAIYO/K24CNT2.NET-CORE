@model HvpLesson12.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Xác nhận xóa sản phẩm?</h4>
                </div>
                <div class="card-body">
                    <p class="text-danger">Bạn có chắc chắn muốn xóa sản phẩm này không?</p>
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            @if (!string.IsNullOrEmpty(Model.Image)) {
                                <img src="~/Product/@Model.Image" alt="@Model.Name" class="img-fluid rounded shadow" style="max-height: 160px; object-fit: contain;" />
                            }
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
                                <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Name)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Category)</dt>
                                <dd class="col-sm-8">@(Model.Category?.Name ?? "Chưa phân loại")</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
                                <dd class="col-sm-8 text-primary fw-bold">@Model.Price.ToString("N0") VNĐ</dd>
                            </dl>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <input type="submit" value="Xác nhận xóa" class="btn btn-sm btn-danger px-4" />
                            <a class="btn btn-sm btn-secondary px-3" asp-action="Index">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
