@model HvpLesson12.Models.Marks

@{
    ViewData["Title"] = "Xóa điểm số";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Xác nhận xóa điểm?</h4>
                </div>
                <div class="card-body">
                    <p class="text-danger">Bạn có chắc chắn muốn xóa bản ghi điểm này không?</p>
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Student)</dt>
                        <dd class="col-sm-8 fw-bold">@(Model.Student?.StudentName ?? "N/A")</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Subject)</dt>
                        <dd class="col-sm-8">@(Model.Subject?.SubjectName ?? "N/A")</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Score)</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Score</dd>
                    </dl>
                    <form asp-action="Delete" asp-route-subjectId="@Model.SubjectId" asp-route-studentId="@Model.StudentId">
                        <div class="d-flex gap-2">
                            <input type="submit" value="Xác nhận xóa" class="btn btn-sm btn-danger px-4" />
                            <a class="btn btn-sm btn-secondary px-3" asp-action="Index">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
