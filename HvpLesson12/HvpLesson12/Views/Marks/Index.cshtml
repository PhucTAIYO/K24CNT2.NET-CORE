@model IEnumerable<HvpLesson12.Models.Marks>

@{
    ViewData["Title"] = "Quản lý điểm số";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-dark">Quản lý Bảng điểm (Marks)</h2>
        <a class="btn btn-sm btn-success px-3" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Nhập điểm mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Student)</th>
                            <th>@Html.DisplayNameFor(model => model.Subject)</th>
                            <th class="text-center" style="width: 140px;">@Html.DisplayNameFor(model => model.Score)</th>
                            <th class="text-center" style="width: 140px;">Xếp loại</th>
                            <th class="text-center" style="width: 220px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="fw-bold text-primary">@(item.Student?.StudentName ?? "N/A")</td>
                            <td><span class="badge bg-light text-dark border">@(item.Subject?.SubjectName ?? "N/A")</span></td>
                            <td class="text-center fw-bold fs-6 @(item.Score >= 5 ? "text-success" : "text-danger")">
                                @item.Score
                            </td>
                            <td class="text-center">
                                @if (item.Score >= 8.5) { <span class="badge bg-success">Giỏi</span> }
                                else if (item.Score >= 7) { <span class="badge bg-primary">Khá</span> }
                                else if (item.Score >= 5) { <span class="badge bg-warning text-dark">Trung bình</span> }
                                else { <span class="badge bg-danger">Yếu</span> }
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Edit</a>
                                <a class="btn btn-sm btn-success" asp-action="Details" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Details</a>
                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Delete</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
