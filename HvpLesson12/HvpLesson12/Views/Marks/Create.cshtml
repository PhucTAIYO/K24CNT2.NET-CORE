@model HvpLesson12.Models.Marks

@{
    ViewData["Title"] = "Nhập điểm mới";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Nhập điểm cho sinh viên</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="StudentId" class="form-label fw-bold"></label>
                            <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                                <option value="">-- Chọn sinh viên --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SubjectId" class="form-label fw-bold"></label>
                            <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId">
                                <option value="">-- Chọn môn học --</option>
                            </select>
                            <span asp-validation-for="SubjectId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Score" class="form-label fw-bold"></label>
                            <input asp-for="Score" class="form-control" type="number" step="0.1" min="0" max="10" placeholder="Thang điểm 0 - 10" />
                            <span asp-validation-for="Score" class="text-danger"></span>
                        </div>
                        <div class="d-flex gap-2">
                            <input type="submit" value="Lưu điểm" class="btn btn-sm btn-success px-4" />
                            <a class="btn btn-sm btn-secondary px-3" asp-action="Index">Quay lại danh sách</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
