@model IEnumerable<Lab_Lesson06.Models.Product>
@{
    ViewData["Title"] = "Trang chủ - Cửa hàng trực tuyến";
}

<!-- PHẦN 1: SẢN PHẨM MỚI NHẤT (Load từ View Action của HomeController) -->
<div class="product-section">
    <div class="product-section-header">
        Sản phẩm mới nhất
    </div>
    <div class="product-section-body">
        <div class="row g-3">
            @if (Model != null)
            {
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="product-card">
                            <div class="product-image-wrap">
                                <img src="@item.Image" alt="@item.Name" class="img-fluid" />
                            </div>
                            <div class="product-title">
                                @item.Name
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- PHẦN 2: KHUNG SẢN PHẨM PHÍA DƯỚI (Load từ Component HotProduct) -->
@await Component.InvokeAsync("HotProduct")
