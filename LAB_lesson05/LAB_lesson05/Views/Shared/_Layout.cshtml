<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DEMO LAB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand brand-title me-4" asp-controller="Home" asp-action="Index">DEMO LAB</a>
                <button class="navbar-toggler navbar-dark" type="button" data-bs-toggle="collapse" data-bs-target="#topNavbar" aria-controls="topNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="topNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom active-tab" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#gioi-thieu">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#lien-he">Liên hệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#san-pham">Sản phẩm</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container with 2-column layout -->
    <div class="container my-4">
        <div class="row">
            <!-- Left Sidebar (Loaded from Partial View) -->
            <aside class="col-lg-3 col-md-4 mb-4">
                @await Html.PartialAsync("_CategoryPartial")
            </aside>

            <!-- Right Content Area -->
            <main role="main" class="col-lg-9 col-md-8">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer-custom mt-auto py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6 mb-3 mb-md-0" id="gioi-thieu">
                    <h6 class="footer-heading">GIỚI THIỆU</h6>
                    <p class="footer-text mb-0">
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Debitis ab suscipit deserunt mollitia reiciendis, nobis iure aliquam velit et laboriosam ducimus veritatis corporis est, dolores aperiam! Officiis impedit provident laboriosam.
                    </p>
                </div>
                <div class="col-md-6" id="lien-he">
                    <h6 class="footer-heading">LIÊN HỆ</h6>
                    <p class="footer-text mb-0">
                        Lorem, ipsum dolor sit amet consectetur adipisicing elit. Odit amet suscipit quasi quisquam impedit magni molestias. Dolores, aliquid commodi ut esse eos voluptatem nisi facilis dolorem, repudiandae culpa ea quidem.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
