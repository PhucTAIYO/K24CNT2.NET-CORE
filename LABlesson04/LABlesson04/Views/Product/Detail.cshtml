@model LABlesson04.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm - " + Model.Name;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/san-pham" class="text-decoration-none">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="card shadow-sm border">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Thông tin chi tiết sản phẩm #@Model.Id</h5>
            <span class="badge @(Model.Status ? "bg-success" : "bg-danger")">
                @(Model.Status ? "Còn hàng" : "Hết hàng")
            </span>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <!-- Cột hình ảnh sản phẩm -->
                <div class="col-md-5 text-center mb-4 mb-md-0">
                    <div class="border rounded p-3 bg-light">
                        <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded" style="max-height: 380px; object-fit: contain;" />
                    </div>
                </div>

                <!-- Cột chi tiết thông tin -->
                <div class="col-md-7">
                    <h3 class="fw-bold text-dark mb-3">@Model.Name</h3>

                    <div class="mb-3 p-3 bg-light rounded border">
                        <div class="d-flex align-items-baseline gap-3">
                            <span class="text-muted fs-5">Giá gốc: <del>@Model.Price.ToString("N0") VNĐ</del></span>
                            <span class="text-danger fw-bold fs-4">Giá khuyến mãi: @Model.SalePrice.ToString("N0") VNĐ</span>
                        </div>
                        @if (Model.Price > Model.SalePrice && Model.Price > 0)
                        {
                            var discountPercent = (int)Math.Round((1 - (Model.SalePrice / Model.Price)) * 100);
                            <small class="badge bg-danger mt-1">Tiết kiệm @discountPercent%</small>
                        }
                    </div>

                    <table class="table table-bordered mb-4">
                        <tbody>
                            <tr>
                                <th scope="row" style="width: 30%;" class="bg-light">Mã sản phẩm (Id)</th>
                                <td>@Model.Id</td>
                            </tr>
                            <tr>
                                <th scope="row" class="bg-light">Danh mục (Category)</th>
                                <td>
                                    <a href="/san-pham?categoryId=@Model.CategoryId" class="badge bg-secondary text-decoration-none">
                                        @ViewBag.CategoryName (Mã: @Model.CategoryId)
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <th scope="row" class="bg-light">Trạng thái (Status)</th>
                                <td>
                                    @if (Model.Status)
                                    {
                                        <span class="text-success fw-semibold">&#x2714; Đang kinh doanh</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold">&#x2716; Tạm ngừng kinh doanh</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th scope="row" class="bg-light">Ngày tạo (CreatedAt)</th>
                                <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mb-4">
                        <h6 class="fw-bold text-secondary">Mô tả sản phẩm:</h6>
                        <p class="text-muted lh-base">
                            @Model.Description
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="/san-pham" class="btn btn-outline-secondary">
                            &larr; Quay lại danh sách sản phẩm
                        </a>
                        <button class="btn btn-success" onclick="alert('Đã thêm sản phẩm vào giỏ hàng!');">
                            Mua ngay
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
