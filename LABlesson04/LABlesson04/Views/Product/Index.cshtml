@model LABlesson04.Models.ProductViewModel

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="row mt-3">
    <!-- Cột trái: DANH MỤC -->
    <div class="col-md-3">
        <h5 class="text-secondary fw-bold mb-3">DANH MỤC</h5>
        <div class="list-group shadow-sm">
            <a href="/san-pham" 
               class="list-group-item list-group-item-action @(Model.SelectedCategoryId == null || Model.SelectedCategoryId == 0 ? "active bg-secondary border-secondary text-white" : "text-muted")">
                Tất cả sản phẩm
            </a>
            @foreach (var category in Model.Categories)
            {
                <a href="/san-pham?categoryId=@category.Id" 
                   class="list-group-item list-group-item-action @(Model.SelectedCategoryId == category.Id ? "active bg-secondary border-secondary text-white fw-bold" : "text-secondary")"
                   style="font-size: 0.95rem;">
                    @category.Name
                </a>
            }
        </div>
    </div>

    <!-- Cột phải: DANH SÁCH SẢN PHẨM -->
    <div class="col-md-9">
        <h4 class="text-dark fw-normal mb-4">Danh sách sản phẩm</h4>

        @if (!Model.Products.Any())
        {
            <div class="alert alert-info">Không có sản phẩm nào thuộc danh mục này.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @foreach (var item in Model.Products)
                {
                    <div class="col">
                        <div class="card h-100 border shadow-sm">
                            <div class="bg-white p-2 text-center" style="height: 240px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                <img src="@item.Image" class="img-fluid rounded" alt="@item.Name" style="max-height: 220px; object-fit: contain;">
                            </div>
                            <div class="card-body d-flex flex-column p-3">
                                <h6 class="card-title text-dark fw-bold mb-2 text-truncate" title="@item.Name">
                                    @item.Name
                                </h6>
                                <div class="mb-3" style="font-size: 0.85rem;">
                                    <span class="text-muted">Giá: </span>
                                    <del class="text-muted">@item.Price.ToString("0")</del>
                                    <span class="ms-2 text-secondary fw-semibold">Giá: @item.SalePrice.ToString("0")</span>
                                </div>
                                <div class="mt-auto">
                                    <a href="/san-pham/detail/@item.Id" class="btn btn-success w-100 py-1" style="background-color: #4CAF50; border-color: #4CAF50;">
                                        Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
