@model IEnumerable<hvpLesson4.Models.hvpProduct>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<hvpLesson4.Models.hvpCategory>;
}

<div class="row mt-3">
    <!-- Sidebar DANH MỤC -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light text-uppercase fw-bold text-secondary">
                DANH MỤC
            </div>
            <div class="list-group list-group-flush">
                <a href="@Url.Action("Index", "hvpProduct")" class="list-group-item list-group-item-action">Tất cả sản phẩm</a>
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        <a href="@Url.Action("Index", "hvpProduct", new { categoryId = cat.Id })" class="list-group-item list-group-item-action">
                            @cat.Name
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Main Content Danh sách sản phẩm -->
    <div class="col-md-9">
        <h3 class="fw-bold mb-3 border-bottom pb-2">Danh sách sản phẩm</h3>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <img src="@item.Image" class="card-img-top p-2" alt="@item.Name" style="height: 200px; object-fit: cover; border-radius: 8px;" />
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold text-dark mb-2">@item.Name</h6>
                            <div class="mt-auto">
                                <p class="card-text mb-2 small text-muted">
                                    <span class="text-decoration-line-through me-2">Giá: @item.OldPrice.ToString("N0")</span>
                                    <span class="text-dark fw-semibold">Giá: @item.Price.ToString("N0")</span>
                                </p>
                                <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-success btn-sm w-100">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
