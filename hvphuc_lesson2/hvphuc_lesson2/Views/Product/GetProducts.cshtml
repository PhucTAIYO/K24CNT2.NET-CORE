@{
    ViewData["Title"] = "Get Single Product";
}

<div class="container mt-4">
    <div class="row">
        <!-- ViewBag Section -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Dữ liệu lấy ra từ ViewBag</h4>
                </div>
                <div class="card-body">
                    <p><strong>Mã sản phẩm:</strong> @ViewBag.productVB.ProductId</p>
                    <p><strong>Tên sản phẩm:</strong> @ViewBag.productVB.ProductName</p>
                    <p><strong>Năm sản xuất:</strong> @ViewBag.productVB.YearRelease</p>
                    <p><strong>Giá:</strong> $ @ViewBag.productVB.Price</p>
                </div>
            </div>
        </div>

        <!-- ViewData Section -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Dữ liệu lấy ra từ ViewData</h4>
                </div>
                <div class="card-body">
                    @{
                        // Phải chuyển đổi về kiểu Product
                        var product = ViewData["productVd"] as hvphuc_lesson2.Models.Product;
                    }
                    @if (product != null)
                    {
                        <p><strong>Mã sản phẩm:</strong> @product.ProductId</p>
                        <p><strong>Tên sản phẩm:</strong> @product.ProductName</p>
                        <p><strong>Năm sản xuất:</strong> @product.YearRelease</p>
                        <p><strong>Giá:</strong> $ @product.Price</p>
                    }
                    else
                    {
                        <p class="text-danger">Không có dữ liệu trong ViewData</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-3">
        <a href="/Product" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
