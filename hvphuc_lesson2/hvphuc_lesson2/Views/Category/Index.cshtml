@{
    ViewData["Title"] = "Danh sách danh mục";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4 text-success">Danh mục loại sản phẩm</h1>
        <p class="lead">Demo tính năng <strong>Attribute Route</strong> trong ASP.NET Core MVC</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Danh sách loại sản phẩm</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.categories != null && ((string[])ViewBag.categories).Length > 0)
                    {
                        <ul class="list-group">
                            @foreach (var item in ViewBag.categories)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @item
                                    <span class="badge bg-success rounded-pill">Active</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-danger text-center mb-0">Không có danh mục nào phù hợp.</p>
                    }
                </div>
            </div>
            
            <div class="mt-4">
                <h5>Tìm kiếm danh mục (Route: <code>loai-san-pham/tim-kiem/{name}</code>):</h5>
                <div class="input-group">
                    <input type="text" id="categoryKeyword" class="form-control" placeholder="Nhập từ khóa (ví dụ: Máy, Laptop)">
                    <button class="btn btn-success" onclick="searchCategory()">Tìm kiếm</button>
                </div>
                <div class="mt-3 d-flex flex-wrap gap-2">
                    <a href="/loai-san-pham" class="btn btn-sm btn-outline-success">Mặc định (/loai-san-pham)</a>
                    <a href="/loai-san-pham/tat-ca" class="btn btn-sm btn-outline-success">Tất cả (/loai-san-pham/tat-ca)</a>
                    <a href="/loai-san-pham/tim-kiem/Máy" class="btn btn-sm btn-outline-success">Tìm "Máy" (/loai-san-pham/tim-kiem/Máy)</a>
                </div>
            </div>
            
            <div class="text-center mt-5">
                <a href="/Product" class="btn btn-secondary">Quay lại trang quản lý sản phẩm</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function searchCategory() {
            var keyword = document.getElementById("categoryKeyword").value.trim();
            if (keyword) {
                window.location.href = "/loai-san-pham/tim-kiem/" + encodeURIComponent(keyword);
            } else {
                window.location.href = "/loai-san-pham";
            }
        }
    </script>
}
