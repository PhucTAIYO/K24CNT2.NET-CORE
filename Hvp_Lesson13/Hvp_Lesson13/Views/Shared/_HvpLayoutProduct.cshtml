<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/HvpLayoutProduct.css" rel="stylesheet" />

</head>
<body>
    <header class="container border my-2">
       <div class="logo">
            <img src="https://daihocnguyentrai.edu.vn/wp-content/uploads/2024/03/logo.png" alt="NTU" />
       </div>
    </header>
    <nav class="container border my-2">
        <ul>
            <li><a asp-controller="HvpProducts" asp-action="Index">Danh sách Sản phẩm</a></li>
            <li><a asp-controller="HvpProducts" asp-action="Search">Tìm kiếm sản phẩm</a></li>
            <li><a asp-controller="HvpProducts" asp-action="Hots">Sản phẩm  bán chạy</a></li>
        </ul>
    </nav>
    <section class="main container border my-2">
        @RenderBody()
    </section>

    <footer style="background-color: #303042; color:yellow; height:50px" class="border my-2">
        <p class="text-center">&copy; 2026 - @@Copyright By @@Hoàng Văn Phúc</p>
    </footer>

    <script src="/js/HvpLayoutHome.js"></script>
</body>
</html>
